//  |   __|  _  |   __|_   _|   __|   __|_   _|     |  |  |
//  |   __|     |__   | | | |   __|   __| | | |   --|     |
//  |__|  |__|__|_____| |_| |__|  |_____| |_| |_____|__|__|  
//
//  
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // "source": "~/.config/fastfetch/image.png",
    "type": "kitty-icat",
    "height": 15,
    "padding": {
      "top": 4
    }
  },
  
  "display": {
    "separator": " ➜ ",
    "color": {
      "keys": "#9dcbfb",
      "title": "#d4bee6",
      "output": "#e0e2e8",
      "separator": "#8c9199"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
    },
    "break",
    {
      "type": "title",
      "keyWidth": 8
    },
    {
      "type": "custom",
      "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    },
    "break",
    {
      "type": "os",
      "format": "{2} {9}",
      "key": " OS   ",
      "keyColor": "#9dcbfb"
    },
    {
      "type": "command",
      "key": " ├   ",
      "keyColor": "#9dcbfb",
      "text": "uname -r | sed 's/.nobara.fc43.x86_64//'"
    },
    {
      "type": "packages",
      "format": "{1} (dnf)",
      "key": " ├   ",
      "keyColor": "#9dcbfb"
    },
    {
      "type": "shell",
      "format": "{1}",
      "key": " └   ",
      "keyColor": "#9dcbfb"
    },
    "break",
    {
      "type": "wm",
      "key": " WM   ",
      "keyColor": "#bac8da"
    },
    {
      "type": "wmtheme",
      "key": " ├ 󰉼  ",
      "keyColor": "#bac8da"
    },
    {
      "type": "icons",
      "key": " ├ 󰀻  ",
      "keyColor": "#bac8da"
    },

    {
      "type": "terminalfont",
      "key": " ├   ",
      "keyColor": "#bac8da"
    },
    {
      "type": "terminal",
      "format": "{1}",
      "key": " └   ",
      "keyColor": "#bac8da"
    },
    "break",
    {
      "type": "host",
      "format": "{2}",
      "key": " PC   ",
      "keyColor": "#d4bee6"
    },
    {
      "type": "command",
      "key": " ├   ",
      "keyColor": "#d4bee6",
      "text": "fastfetch --cpu-format '{1}' --logo none | sed 's/ (R)//;s/ (TM)//;s/ 11th Gen//;s/ @.*//'"
    },
    {
      "type": "command",
      "key": " ├ 󰢮  ",
      "keyColor": "#d4bee6",
      "text": "nvidia-smi --query-gpu=name --format=csv,noheader | sed 's/ Mobile//;s/ Laptop GPU//'"
    },
    {
      "type": "memory",
      "key": " ├   ",
      "keyColor": "#d4bee6"
    },
    {
      "type": "swap",
      "key": " ├ 󰓡  ",
      "keyColor": "#d4bee6"
    },
    {
      "type": "disk",
      "format": "{1} / {2} ({3})",
      "key": " ├ 󰋊  ",
      "keyColor": "#d4bee6"
    },
    {
      "type": "monitor",
      "format": "{2}x{3} @ {11} Hz",
      "key": " └   ",
      "keyColor": "#d4bee6"
    },
    "break",
    {
      "type": "uptime",
      "key": " UP   ",
      "keyColor": "#9dcbfb"
    },
    {
      "type": "datetime",
      "format": "{1}-{3}-{11}",
      "key": " ├   ",
      "keyColor": "#9dcbfb"
    },
    {
      "type": "command",
      "key": " └   ",
      "keyColor": "#9dcbfb",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    "break",
    {
      "type": "command",
      "key": " SH   ",
      "keyColor": "#9dcbfb",
      "text": "splash=$(hyprctl splash);echo $splash"
    },
    {
      "type": "custom",
      "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
    },
    "break",
    "break"
  ]
}