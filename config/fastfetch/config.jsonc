{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-icat",
    "height": 15,
    "padding": { "top": 4 }
  },
  "display": {
    "separator": " ➜ ",
    "color": {
      "keys": "__PRIMARY__",
      "title": "__TERTIARY__",
      "output": "__ON_SURFACE__",
      "separator": "__OUTLINE__"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 8
    },
    "break",
    {
      "type": "os",
      "format": "{2} {9}",
      "key": " OS   ",
      "keyColor": "__PRIMARY__"
    },
    {
      "type": "kernel",
      "key": " ├  ",
      "keyColor": "__PRIMARY__"
    },
    {
      "type": "packages",
      "key": " ├ 󰏗  ",
      "keyColor": "__PRIMARY__"
    },
    {
      "type": "shell",
      "key": " └  ",
      "keyColor": "__PRIMARY__"
    },
    "break",
    {
      "type": "wm",
      "key": " WM   ",
      "keyColor": "__SECONDARY__"
    },
    {
      "type": "wmtheme",
      "key": " ├ 󰉼  ",
      "keyColor": "__SECONDARY__"
    },
    {
      "type": "terminal",
      "format": "{1}",
      "key": " └ 󰆧  ",
      "keyColor": "__SECONDARY__"
    },
    "break",
    {
      "type": "host",
      "format": "{2}",
      "key": " PC   ",
      "keyColor": "__TERTIARY__"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": " ├ 󰍛  ",
      "keyColor": "__TERTIARY__"
    },
    {
      "type": "gpu",
      "format": "{1}",
      "key": " ├ 󰢮  ",
      "keyColor": "__TERTIARY__"
    },
    {
      "type": "memory",
      "format": "{1} / {2}",
      "key": " └ 󰍛  ",
      "keyColor": "__TERTIARY__"
    },
    "break",
    {
      "type": "uptime",
      "key": " UP   ",
      "keyColor": "__PRIMARY__"
    },
    "break"
  ]
}
