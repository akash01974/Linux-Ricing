# matugen btop theme - Material You

# Main background
theme[main_bg]="{{ colors.surface_container_lowest.default.hex }}"

# Main text color
theme[main_fg]="{{ colors.on_surface.default.hex }}"

# Title color for boxes
theme[title]="{{ colors.primary.default.hex }}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{ colors.primary.default.hex }}"

# Background color of selected item in processes box
theme[selected_bg]="{{ colors.primary_container.default.hex }}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{ colors.on_primary_container.default.hex }}"

# Color of inactive/disabled text
theme[inactive_fg]="{{ colors.outline.default.hex }}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{ colors.tertiary.default.hex }}"

# Cpu box outline color
theme[cpu_box]="{{ colors.outline_variant.default.hex }}"

# Memory/disks box outline color
theme[mem_box]="{{ colors.outline_variant.default.hex }}"

# Net up/down box outline color
theme[net_box]="{{ colors.outline_variant.default.hex }}"

# Processes box outline color
theme[proc_box]="{{ colors.outline_variant.default.hex }}"

# Box divider line and small boxes line color
theme[div_line]="{{ colors.outline_variant.default.hex }}"

# Temperature graph colors
theme[temp_start]="{{ colors.primary.default.hex }}"
theme[temp_mid]="{{ colors.tertiary.default.hex }}"
theme[temp_end]="{{ colors.error.default.hex }}"

# CPU graph colors
theme[cpu_start]="{{ colors.primary.default.hex }}"
theme[cpu_mid]="{{ colors.tertiary.default.hex }}"
theme[cpu_end]="{{ colors.error.default.hex }}"

# Mem/Disk free meter
theme[free_start]="{{ colors.primary.default.hex }}"
theme[free_mid]="{{ colors.primary_fixed_dim.default.hex }}"
theme[free_end]="{{ colors.primary_fixed.default.hex }}"

# Mem/Disk cached meter
theme[cached_start]="{{ colors.secondary.default.hex }}"
theme[cached_mid]="{{ colors.secondary_fixed_dim.default.hex }}"
theme[cached_end]="{{ colors.secondary_fixed.default.hex }}"

# Mem/Disk available meter
theme[available_start]="{{ colors.tertiary.default.hex }}"
theme[available_mid]="{{ colors.tertiary_fixed_dim.default.hex }}"
theme[available_end]="{{ colors.tertiary_fixed.default.hex }}"

# Mem/Disk used meter
theme[used_start]="{{ colors.error.default.hex }}"
theme[used_mid]="{{ colors.error_container.default.hex }}"
theme[used_end]="{{ colors.on_error_container.default.hex }}"

# Download graph colors
theme[download_start]="{{ colors.primary.default.hex }}"
theme[download_mid]="{{ colors.tertiary.default.hex }}"
theme[download_end]="{{ colors.error.default.hex }}"

# Upload graph colors
theme[upload_start]="{{ colors.secondary.default.hex }}"
theme[upload_mid]="{{ colors.tertiary.default.hex }}"
theme[upload_end]="{{ colors.error.default.hex }}"
