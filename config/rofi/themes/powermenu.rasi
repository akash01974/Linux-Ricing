/**
 * Material You Glassmorphic Power Menu
 * Replaces wlogout — Rofi-based
 **/

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 764px;
    background-color: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(71, 70, 79, 0.15);
    border-radius: 28px;
    padding: 18px;
    cursor: "default";
}

mainbox {
    enabled: true;
    spacing: 0;
    padding: 24px 28px;
    background-color: rgba(14, 14, 19, 0.55);
    border: 1px solid rgba(71, 70, 79, 0.12);
    border-radius: 24px;
    children: [ "listview" ];
}

listview {
    enabled: true;
    columns: 5;
    lines: 1;
    cycle: true;
    dynamic: false;
    scrollbar: false;
    layout: horizontal;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    spacing: 12px;
    margin: 0;
    padding: 0;
    border: 0px solid;
    border-radius: 0;
    background-color: transparent;
    text-color: @foreground;
    cursor: "default";
}

element {
    enabled: true;
    spacing: 2px;
    margin: 0;
    padding: 8px;
    border: 1px solid rgba(71, 70, 79, 0.2);
    border-radius: 16px;
    background-color: rgba(19, 19, 24, 0.65);
    text-color: @foreground;
    orientation: vertical;
    cursor: pointer;
    transition: background-color 0.2s ease,
                border-color 0.2s ease;

    min-width: 120px;
    min-height: 120px;
}

element normal.normal {
    background-color: rgba(19, 19, 24, 0.65);
    text-color: @foreground;
}

element selected.normal {
    background-color: rgba(42, 41, 47, 0.85);
    border-color: rgba(193, 193, 255, 0.4);
    text-color: @foreground;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
}

element selected.active {
    background-color: rgba(42, 41, 47, 0.9);
    border-color: rgba(193, 193, 255, 0.6);
    text-color: @foreground;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 36px;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    highlight: inherit;
}

error-message {
    padding: 15px;
    border: 0px solid;
    border-radius: 0;
    background-color: transparent;
    text-color: @foreground;
}

textbox {
    background-color: transparent;
    text-color: @foreground;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    highlight: none;
}
