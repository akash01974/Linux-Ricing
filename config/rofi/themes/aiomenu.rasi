/**
 * All-in-one menu theme — matches clipboard sizing
 **/

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

window {
    transparency: "real";
    location: south;
    anchor: south;
    fullscreen: false;
    width: 600px;
    x-offset: 0px;
    y-offset: 0px;
    enabled: true;
    margin: 0px;
    padding: 0px;
    border: 1px solid;
    border-radius: 10px 10px 0px 0px;
    border-color: @background-alt;
    background-color: rgba(19, 19, 24, 0.4);
}

mainbox {
    enabled: true;
    spacing: 4px;
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    background-color: transparent;
    children: [ "listview" ];
}

listview {
    enabled: true;
    columns: 1;
    lines: 7;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    spacing: 10px;
    margin: 0px;
    padding: 18px 14px;
    background-color: transparent;
    text-color: @foreground;
}

element {
    enabled: true;
    spacing: 8px;
    margin: 0px;
    padding: 10px 12px;
    border: 0px solid;
    border-radius: 8px;
    background-color: transparent;
    text-color: @foreground;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @background-alt;
    text-color: @foreground;
    border-radius: 8px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    font: "FiraCode Nerd Font 13";
}

element-icon {
    size: 1em;
}

scrollbar {
    handle-width: 5px;
    handle-color: @selected;
    border-radius: 4px;
    background-color: @background-alt;
}
